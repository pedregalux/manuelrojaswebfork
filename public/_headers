# Cache agresivo para media estática (nombres no cambian salvo re-upload)
/media/*
  Cache-Control: public, max-age=31536000, immutable

# Cache agresivo para assets hasheados de Astro
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Cache para páginas HTML (actualizadas en cada deploy)
/*
  Cache-Control: public, max-age=0, must-revalidate
